{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
  <main class="main bg-dark">
    <section class="sign-in-content">
      <i class="fa fa-user-circle sign-in-icon"></i>
      <h1>Creation de compte</h1>
      {% if error %}
        <p class="sign-in-error">{{ error }}</p>
      {% endif %}
      <form method="post" action="{{ path('register_submit') }}">
        <div class="input-wrapper">
          <label for="firstName">Prenom</label>
          <input type="text" id="firstName" name="firstName" value="{{ values.firstName|default('') }}" required />
        </div>
        <div class="input-wrapper">
          <label for="lastName">Nom</label>
          <input type="text" id="lastName" name="lastName" value="{{ values.lastName|default('') }}" required />
        </div>
        <div class="input-wrapper">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="{{ values.email|default('') }}" required />
        </div>
        <div class="input-wrapper">
          <label for="password">Mot de passe</label>
          <input type="password" id="password" name="password" required />
        </div>
        <button class="sign-in-button" type="submit">Creer le compte</button>
      </form>
      <p class="form-link">
        <a href="{{ path('login') }}">J'ai deja un compte</a>
      </p>
    </section>
  </main>
{% endblock %}
